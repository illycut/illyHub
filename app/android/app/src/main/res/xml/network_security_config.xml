<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed only where a home hub can live: private LAN ranges and .local names
  (docs/android.md). Everything else must be HTTPS. usesCleartextTraffic in the manifest is the
  legacy switch; on API 24+ this file is what applies.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.0.0/8</domain>
        <domain includeSubdomains="false">172.16.0.0/12</domain>
        <domain includeSubdomains="false">192.168.0.0/16</domain>
    </domain-config>
</network-security-config>
