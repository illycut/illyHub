HUB_HOST=0.0.0.0
HUB_PORT=8080

# Logging. Stdout always gets JSON lines. When HUB_LOG_FILE is set, the file receives the
# full HUB_LOG_LEVEL stream (rotated at 10 MB x 7) and stdout drops to HUB_STDOUT_LEVEL
# (default WARNING with a log file, INFO without) so launchd's capture file stays small.
HUB_LOG_LEVEL=INFO
# HUB_LOG_FILE=/Users/hub/Library/Logs/illyhub/hub.log
# HUB_STDOUT_LEVEL=WARNING

# Point at a different env file (default .env)
# HUB_ENV_FILE=.env.local

# Use protocol fakes instead of real hardware
HUB_FAKE_DEVICES=1
# Optional fixed hosts (skip SSDP for these)
# HUB_HEOS_HOST=192.168.1.20
# HUB_DENON_HOST=192.168.1.20
# Telnet (port 23) is the Denon control path: current firmware returns 403 for every legacy
# /goform/ endpoint, and HEOS cannot set volume on an AVR-hosted player. Set 0 only for an
# older receiver whose HTTP form API still answers.
# HUB_DENON_TELNET=1
# HUB_DENON_POLL_S=15
# Hub volume 100 maps to this MV step. MV98 is +18 dB, so the cap is a safety limit, not a
# preference; the receiver's own MVMAX is ignored because it reports inconsistently.
# HUB_DENON_MAX_VOLUME=60
# Zones whose output is a fixed pre-out to an external amp: the receiver cannot attenuate them,
# so the hub reports them volume-incapable instead of offering a slider that does nothing.
# HUB_DENON_FIXED_ZONES=["zone2"]
# JSON list of static devices: [{"id":"...","vendor":"heos|sonos","ip":"...","name":"..."}]
# HUB_STATIC_DEVICES=[]
# Minimum seconds between device writes per volume/seek target (slider drags coalesce).
# HUB_COMMAND_COALESCE_S=0.1

# Phase 2: art proxy, PWA serving, TLS. Relative paths are relative to hub/.
# HUB_DATA_DIR must be an ABSOLUTE path outside the repo on the hub Mac: the hub runs as a root
# LaunchDaemon, so a relative path scatters root-owned files through the checkout and breaks
# running the hub or pytest as yourself. Keep the directory 0700 and vault.key 0600.
# HUB_DATA_DIR=/usr/local/var/illyhub    # art cache lives in $HUB_DATA_DIR/art
# HUB_ART_PROXY=1                       # 0 = every art ref serves the neutral placeholder
# HUB_ART_TTL_DAYS=30
# HUB_ART_MAX_MB=500                    # LRU trim budget for cached variants (daily sweep)
# HUB_ART_FETCH_TIMEOUT_S=5
# HUB_APP_DIR=../app/out                # Next.js static export served at /
# HUB_FONTS_DIR=../app/public/fonts     # self-hosted General Sans served at /fonts
# HUB_TLS_CERT=                         # mkcert path: PEM cert + key (both files must exist)
# HUB_TLS_KEY=                          # (leave both empty when using `tailscale serve`)

# Phase 3: accounts, Tidal, history. The vault holds OAuth tokens encrypted at rest.
# HUB_VAULT_KEY=                        # Fernet key. Unset = generated once into $HUB_DATA_DIR/vault.key
#                                       # (mode 0600). That file must never leave the hub Mac.
# HUB_SONOS_TIDAL_SN=                   # Sonos account serial ("sn") for Tidal URIs, if the hub
#                                       # cannot read it from the household accounts
# HUB_BROWSE_CACHE_S=300                # Tidal browse cache TTL
# HUB_HISTORY_MAX_ROWS=500              # play history retention
# HUB_ALLOW_RESTART=1                   # POST /api/hub/restart exits the process for launchd
# HUB_FAKE_TIDAL=1                      # with HUB_FAKE_DEVICES=1: canned Tidal library, no account

# Request-origin policy (CSRF / DNS-rebinding). Defaults always include localhost, 127.0.0.1,
# the hub's LAN IP and *.local. Add the tailnet MagicDNS name and any mkcert name you use.
# HUB_ALLOWED_HOSTS=["hub-mac.tailnet-name.ts.net","hub.local"]
# HUB_ALLOWED_ORIGINS=["https://hub-mac.tailnet-name.ts.net"]

# Phase 4: Sync Play (docs/sync-engine.md). HEOS is the clock master; only Sonos is corrected.
# All six are hot-reloadable via POST /api/sync/config.
# HUB_SYNC_DRIFT_MS=300                 # correct the follower when |drift| exceeds this
# HUB_SYNC_SAMPLES=2                    # ...for this many consecutive samples
# HUB_SYNC_CORRECTION_GAP_S=10          # at most one follower seek per this many seconds
# HUB_SYNC_LOOKAHEAD_MS=400             # initial seek lookahead; replaced by the measured latency
# HUB_SYNC_MONITOR_S=0.5                # drift sampling interval
# HUB_SYNC_TRACK_GRACE_S=3              # follower may lag a track change this long before re-prime
# HUB_SYNC_MAX_SESSIONS=50              # drift logs (data/sync/*.csv + .json) kept on disk

# Phase 5: Pandora stations. No hub account: each vendor app links Pandora itself; the hub lists
# stations per system and merges them by name (docs/spikes/pandora-refs.md).
# HUB_SONOS_PANDORA_SN=                 # Sonos account serial ("sn") for Pandora URIs, if the hub
#                                       # cannot read it from the household accounts (type 60423)
# HUB_FAKE_PANDORA=1                    # with HUB_FAKE_DEVICES=1: five canned stations per vendor

# Phase 6: YouTube Music. Browse through ytmusicapi with a Google OAuth client of the
# "TV and Limited Input devices" type (Google Cloud console → APIs & Services → Credentials;
# enable the YouTube Data API v3 first). Playback is Sonos-native; HEOS has no YouTube Music
# source (docs/spikes/ytmusic-heos.md).
# HUB_YTMUSIC_CLIENT_ID=
# HUB_YTMUSIC_CLIENT_SECRET=
# HUB_SONOS_YTMUSIC_SN=                 # Sonos account serial for YouTube Music (type 72711) if
#                                       # the hub cannot read it from /status/accounts
# HUB_SONOS_YTMUSIC_URI=                # override the assumed track URI template, e.g.
#                                       # "x-sonosapi-hls-static:{id}?sid=284&flags=8&sn={sn}"
# HUB_FAKE_YTMUSIC=1                    # with HUB_FAKE_DEVICES=1: canned library, no account

# Phase 7 (P2, experimental): "Pandora Sync" — the hub Mac as an AirPlay 2 sender
# (docs/spikes/airplay-bridge.md). Drives the Music app over AppleScript, which needs the console
# user's GUI session: it does NOT work from the deployed root LaunchDaemon (the hub reports why).
# Run a second hub process as the console user (HUB_AIRPLAY_ENABLED=1 HUB_PORT=8081 uv run hub)
# after approving the Automation prompt once from Terminal; a user-session helper is the
# follow-up (illyHub #28). Off by default.
# HUB_AIRPLAY_ENABLED=1
# HUB_AIRPLAY_TIMEOUT_S=20              # osascript budget per call once Music is running
# HUB_AIRPLAY_LAUNCH_TIMEOUT_S=60       # first call while Music cold-launches

# --- Phase 8: cross-cutting --------------------------------------------------------------
# Self-update via ops/update.sh (POST /api/hub/update/apply). OFF by default: the endpoint runs
# git and the dependency sync as root on this Mac, gated only by the LAN. ops/install.sh asks
# once and writes the answer here. The remote must be https:// or ssh://; the checkout must be
# clean and fast-forwardable. HUB_UPDATE_BRANCH is followed when the branch has no upstream.
# HUB_ALLOW_UPDATE=0
# HUB_UPDATE_BRANCH=main
# HUB_REPO_DIR=/Users/hub/illyHub            # only for an unusual layout
# Native queue read cap (GET /api/queue/{side}), per-service search deadline and result cache.
# HUB_QUEUE_MAX=200
# HUB_SEARCH_DEADLINE_S=4
# HUB_SEARCH_CACHE_S=60
# Metrics uptime tick / daily summary cadence (seconds). Rollups live in HUB_DATA_DIR/metrics.sqlite.
# HUB_METRICS_TICK_S=60
